def page(title, body, active=None, sidebar_items=None):
    sidebar = ""
    if sidebar_items:
        links = "\n".join([f'<a class="{ "active" if k==active else "" }" href="{href}">{name}</a>' for k, name, href in sidebar_items])
        sidebar = f"""<aside id="sidebar" class="sidebar">
  <div class="sidebar-head">
    <span class="sidebar-title">{title}</span>
    <button class="toggle-btn" onclick="toggleSidebar()">☰</button>
  </div>
  <a class="sidebar-home" href="index.html">← Back to main page</a>
  <div class="sidebar-list">{links}</div>
</aside>"""
        main = f'<main class="page-shell">{sidebar}<article class="content">{body}</article></main>'
    else:
        main = body
    return f"""<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{html.escape(title)} | Prathivee</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
{topbar}
{main}
<script src="script.js"></script>
</body>
</html>"""

